#!/bin/sh
# Keep main fast-forward only. Remote branch protection is managed separately.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "Refusing a non-fast-forward update to main." >&2
      exit 1
    fi
  fi
done

